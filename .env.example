# Copy to .env and fill in as needed. .env is git-ignored.
#
# All settings are nested under Settings (see src/research_navigator/config.py):
# env prefix RN_, nested delimiter __ (double underscore). A single-underscore
# name like RN_QDRANT_HOST is silently ignored by pydantic-settings (extra
# fields are dropped, not errored) — always use the double-underscore form.
RN_QDRANT__HOST=localhost
RN_QDRANT__PORT=6333
RN_LOGGING__LEVEL=INFO
RN_LOGGING__JSON_LOGS=false

# LLM (generation + the M4 judge). OpenAI (default model: gpt-4o-mini):
# RN_LLM__API_KEY=...

# Or any OpenAI-compatible endpoint (no code changes needed), e.g. Gemini:
# RN_LLM__API_KEY=...
# RN_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RN_LLM__MODEL=gemini-3.6-flash
#
# NOTE: Gemini's free tier caps at 20 requests/day per model, which is not
# enough to run `make eval` (80+ LLM calls: 40 questions x 2 configs, plus
# the judge) or sustained `ask`/`answer` usage.

# Recommended for `make eval` / heavy local use: a local OSS-compatible
# server (Ollama, no root required — see docs/adr/0010-local-llm-for-eval.md
# for the exact no-sudo install used in this environment). No quota, no
# network egress at query time, works fully offline once the model is
# pulled:
RN_LLM__API_KEY=ollama
RN_LLM__BASE_URL=http://127.0.0.1:11434/v1
RN_LLM__MODEL=llama3.2:3b
