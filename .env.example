# Copy to .env and fill in as needed. .env is git-ignored.
RN_QDRANT_HOST=localhost
RN_QDRANT_PORT=6333
RN_LOG_LEVEL=INFO
RN_LOG_JSON=false

# LLM (generation). OpenAI (default):
# RN_LLM__API_KEY=...

# Or Gemini, via its OpenAI-compatible endpoint (no code changes needed):
# RN_LLM__API_KEY=...
# RN_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RN_LLM__MODEL=gemini-3.6-flash
